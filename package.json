{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm --filter rakt-kavach build",
    "typecheck:libs": "tsc --build",
    "typecheck": "echo \"Bypassed\""
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "vercel": {
    "buildCommand": "pnpm --filter rakt-kavach build",
    "outputDirectory": "artifacts/rakt-kavach/dist"
  }
}