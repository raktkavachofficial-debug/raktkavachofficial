modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true", "PORT" = "3000", "VITE_PORT" = "3000" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["yakut"]

# 🚀 सिर्फ पोर्ट 3000 को खोलने और चलाने के लिए सख्त निर्देश
[[ports]]
local = 3000
external = true

[run]
compile = "pnpm install"
command = "PORT=3000 VITE_PORT=3000 pnpm --filter rakt-kavach build"
